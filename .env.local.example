# Neon PostgreSQL. For Vercel, use the pooled connection string
# (host contains -pooler, typically port 5432) and keep sslmode=require.
# Quote the value (required on Windows PowerShell if you ever set $env:DATABASE_URL).
# Prisma CLI reads `.env`, not `.env.local` — use `npm run db:push` / `db:seed`,
# or copy this same DATABASE_URL into `.env` so `npx prisma db push` works.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Admin login at /admin — copy this file to .env.local, then restart npm run dev.
# Comma-separated phones (last 10 digits). +91 / spaces are also accepted.
ADMIN_PHONES=9000000000
ADMIN_PASSWORD=change-me

# Cloudinary (https://cloudinary.com) — placeholders only, never commit real secrets.
CLOUDINARY_CLOUD_NAME=
# Safe to expose in the browser (same value as CLOUDINARY_CLOUD_NAME). Never put API key/secret here.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_WEBHOOK_SECRET=
